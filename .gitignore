.venv/
__pycache__/
*.py[cod]
*.egg-info/
.ruff_cache/
# Round tapes: data/roundN_{train,val,test}.csv.gz are tracked; the plain .csv (what the simulator reads) and
# market_data/ (true price and regime labels) are not
data/*
!data/.gitkeep
!data/*.gz
market_data/
# Simulator output
logs/*
!logs/.gitkeep

.DS_Store
# Private analysis findings (fitted generator values), never commit
findings/
# Synthetic tapes (data/synthetic/) stay ignored by data/*: regenerate them, e.g. scripts/gen_tape.py --seed 1 2 3
